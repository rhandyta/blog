{
  "name": "rhandytaverse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RhandytaVERSE — an editorial publishing platform",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun --watch src/server/index.ts",
    "build": "bun scripts/copy-fonts.ts && vite build",
    "start": "bun src/server/index.ts --prod",
    "db:migrate": "bun scripts/migrate.ts",
    "db:seed": "bun scripts/seed.ts",
    "db:reset": "bun scripts/reset.ts",
    "db:rebuild-search": "bun scripts/rebuild-search.ts",
    "db:clear-content": "bun scripts/clear-content.ts",
    "test": "bun test",
    "test:e2e": "node e2e/run.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.1.1",
    "@fontsource-variable/newsreader": "^5.1.1",
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@libsql/client": "^0.18.0",
    "@tiptap/core": "^2.11.2",
    "@tiptap/extension-character-count": "^2.11.2",
    "@tiptap/extension-code-block-lowlight": "^2.11.2",
    "@tiptap/extension-image": "^2.11.2",
    "@tiptap/extension-link": "^2.11.2",
    "@tiptap/extension-placeholder": "^2.11.2",
    "@tiptap/extension-table": "^2.11.2",
    "@tiptap/extension-table-cell": "^2.11.2",
    "@tiptap/extension-table-header": "^2.11.2",
    "@tiptap/extension-table-row": "^2.11.2",
    "@tiptap/extension-underline": "^2.11.2",
    "@tiptap/pm": "^2.11.2",
    "@tiptap/react": "^2.11.2",
    "@tiptap/starter-kit": "^2.11.2",
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "lowlight": "^3.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
