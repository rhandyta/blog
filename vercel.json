{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "bun",
  "bunVersion": "1.x",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist/client",
  "regions": ["hnd1"],
  "functions": {
    "server.ts": {
      "maxDuration": 120,
      "includeFiles": "dist/client/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/automation",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/automation",
      "schedule": "0 14 * * *"
    }
  ]
}
