NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
DATABASE_PATH=./data/commonplace.db
UPLOAD_DIR=./data/uploads
SESSION_SECRET=change-me-to-a-long-random-string-in-production
ADMIN_EMAIL=editor@rhandytaverse.local
ADMIN_PASSWORD=rhandytaverse-dev
SITE_NAME=RhandytaVERSE

# Vercel / Turso. Leave TURSO_DATABASE_URL empty to use the local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob. Leave empty to store uploads on the local filesystem.
BLOB_READ_WRITE_TOKEN=

# Gemini API (Google AI Studio) for the content automation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
